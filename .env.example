# New API compatible video gateway. Fill these values locally.
DRAMA_BASE_URL=
DRAMA_API_KEY=
DRAMA_MODEL=seedance-2.0-fast-0826
# Seedance 2.0 only permits model ids ending in -0826 and uses generations.
# Other supported model families use videos when endpoint is auto.
DRAMA_ENDPOINT=auto
# en or zh; CLI flag --lang overrides this value
DRAMA_LANG=en
